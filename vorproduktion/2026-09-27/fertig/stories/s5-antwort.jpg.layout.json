{"version":1,"breite":1080,"hoehe":1920,"texte":[{"text":"Verwaltungsrecht AT","box":{"x":0,"y":0,"w":373.2,"h":62.8},"schrift":"Inter","groesse":28,"gewicht":"700","farbe":"rgb(255, 255, 255)","ausrichtung":"start","zeilenhoehe":30.8,"lsp":0.6,"rotation":0,"pille":{"box":{"x":0,"y":0,"w":373.2,"h":62.8},"farbe":"rgb(51, 1, 34)","radius":0},"hinter":"rgb(228, 29, 120)"},{"text":"Auflösung","box":{"x":194,"y":322.5,"w":153.1,"h":39},"schrift":"Inter","groesse":32,"gewicht":"700","farbe":"rgb(51, 1, 34)","ausrichtung":"start","zeilenhoehe":null,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":300,"w":289.1,"h":84},"farbe":"rgb(248, 201, 223)","radius":40},"hinter":"rgb(228, 29, 120)"},{"text":"Rechtswidrig ist nicht automatisch nichtig","box":{"x":84,"y":410,"w":912,"h":214.6},"schrift":"Space Grotesk","groesse":74,"gewicht":"700","farbe":"rgb(255, 255, 255)","ausrichtung":"start","zeilenhoehe":88.8,"lsp":-0.7,"rotation":0,"pille":{"box":{"x":84,"y":410,"w":912,"h":214.6},"farbe":"rgb(51, 1, 34)","radius":48},"hinter":"rgb(228, 29, 120)"},{"text":"A","box":{"x":120,"y":714.6,"w":52,"h":156},"schrift":"Space Grotesk","groesse":40,"gewicht":"700","farbe":"rgb(51, 1, 34)","ausrichtung":"start","zeilenhoehe":52,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":684.6,"w":912,"h":216},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"Nein, grundsätzlich bleibt er wirksam, solange er nicht aufgehoben oder anderweitig erledigt ist","box":{"x":196,"y":714.6,"w":764,"h":156},"schrift":"Inter","groesse":40,"gewicht":"400","farbe":"rgb(28, 28, 34)","ausrichtung":"start","zeilenhoehe":52,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":684.6,"w":912,"h":216},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"B","box":{"x":120,"y":954.6,"w":52,"h":104},"schrift":"Space Grotesk","groesse":40,"gewicht":"700","farbe":"rgb(51, 1, 34)","ausrichtung":"start","zeilenhoehe":52,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":924.6,"w":912,"h":164},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"Ja, Rechtswidrigkeit und Nichtigkeit sind dasselbe","box":{"x":196,"y":954.6,"w":764,"h":104},"schrift":"Inter","groesse":40,"gewicht":"400","farbe":"rgb(28, 28, 34)","ausrichtung":"start","zeilenhoehe":52,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":924.6,"w":912,"h":164},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"C","box":{"x":120,"y":1142.6,"w":52,"h":104},"schrift":"Space Grotesk","groesse":40,"gewicht":"700","farbe":"rgb(51, 1, 34)","ausrichtung":"start","zeilenhoehe":52,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":1112.6,"w":912,"h":164},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"Nur belastende Verwaltungsakte bleiben wirksam","box":{"x":196,"y":1142.6,"w":764,"h":104},"schrift":"Inter","groesse":40,"gewicht":"400","farbe":"rgb(28, 28, 34)","ausrichtung":"start","zeilenhoehe":52,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":1112.6,"w":912,"h":164},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"Ein rechtswidriger Verwaltungsakt kann wirksam sein. Nichtigkeit setzt die besonderen Voraussetzungen des § 44 VwVfG voraus. § 43 Abs. 2 VwVfG beschreibt, wann die Wirksamkeit endet.","box":{"x":84,"y":1320.6,"w":912,"h":354},"schrift":"Inter","groesse":42,"gewicht":"400","farbe":"rgb(28, 28, 34)","ausrichtung":"start","zeilenhoehe":58.8,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":1320.6,"w":912,"h":354},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"Öffentliches Recht","box":{"x":769.1,"y":1759,"w":226.9,"h":31},"schrift":"Inter","groesse":26,"gewicht":"700","farbe":"rgb(51, 1, 34)","ausrichtung":"start","zeilenhoehe":null,"lsp":0,"rotation":0,"pille":null,"hinter":"rgb(228, 29, 120)"}],"bilder":[],"quellSha256":"f423524d8dc7ca6978cbdf316a88a0b26bbfd8e06badf2ae62e4e9195949e55