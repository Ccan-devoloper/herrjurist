  "inhalte": {
    "b1": {
      "format": "pruefungsfrage",
      "fach": "strafbt",
      "klausur": 2,
      "fachLabel": "Strafrecht BT",
      "themaId": "strafbt-740",
      "caption": "Giftbecher gereicht – und trotzdem keine Tötung auf Verlangen.\n\n▸ § 216 Abs. 1 StGB setzt voraus, dass der Täter einen anderen tötet. Die Mitwirkung an einer freiverantwortlichen Selbsttötung ist tatbestandslos.\n▸ Abgrenzung nach h. M.: Wer beherrscht den letzten, unmittelbar lebensbeendenden Akt? Trinkt das Opfer selbst, liegt Suizidhilfe vor. Spritzt der Täter das Mittel, kommt bei ausdrücklichem und ernstlichem Verlangen § 216 StGB in Betracht.\n▸ Fehlt die Freiverantwortlichkeit, ist eine Tötung in mittelbarer Täterschaft zu prüfen.\n▸ Verlangen heißt ausdrücklich und ernstlich – bloßes Einverständnis genügt nicht; es muss den Täter zur Tötung bestimmt haben.\n▸ § 217 StGB (geschäftsmäßige Förderung der Selbsttötung) hat das BVerfG für nichtig erklärt (BVerfGE 153, 182).\n\nZum Schluss: der Baustein fürs Gutachten. Speichern fürs Examen 📌",
      "hashtags": [
        "#jura",
        "#jurastudium",
        "#staatsexamen",
        "#strafrecht",
        "#strafrechtbt",
        "#216stgb",
        "#sterbehilfe",
        "#jurastudent",
        "#examensvorbereitung"
      ],
      "quellen": [
        "§ 216 StGB",
        "§ 217 StGB",
        "BVerfGE 153, 182"
      ],
      "slug": "2026-12-07-b1",
      "kurztitel": "Tötung auf Verlangen und Suizidhilfe",
      "regelGeprueft": true,
      "manuellGeprueft": false,
      "freigabeBetreiber": true,
      "vorproduktionStatus": "live-freigegeben",
      "textProviderKostenUsd": 0,
      "faktencheckProviderKostenUsd": 0,
      "bildStatus": "open-peeps-render",
      "renderer": "open-peeps-v4",
      "liveVorrangAktiv": true,
      "coverBadge": "Prüfungsfrage",
      "folien": [
        {
          "art": "titel",
          "titel": "Prüfungsfrage",
          "text": "Prüfungsfrage · Giftbecher gereicht, · kein § 216 StGB · Suizidhilfe · + Gutachten-Baustein",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der Fall · Der schwer kranke O bittet A ausdrücklich und ernstlich um Hilfe beim Sterben. · A mischt ein tödliches Mittel und reicht O das Glas. O trinkt selbst und stirbt. · Jetzt du: Tötung auf Verlangen? · Er hat es gemischt!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der typische Fehler · „A hat das Gift gemischt und gereicht, also getötet.“ · Wer nur reicht, gibt die Herrschaft aus der Hand. Den letzten Akt vollzieht O selbst. · Wer trinkt?"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der Lösungsweg · Fremdtötung? · § 216 Abs. 1 StGB · Hilfe zur freiverantwortlichen Selbsttötung ist tatbestandslos · Letzter Akt · Wer beherrscht ihn? Hier trinkt O selbst · Freiverantwortlich? · sonst Tötung in mittelbarer Täterschaft denkbar · Ergebnis · Suizidhilfe, keine Tötung auf Verlangen · Am Ende: Baustein fürs Gutachten"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Reichen oder spritzen? · O trinkt selbst · Suizidhilfe: straflos · A spritzt · Fremdtötung: bei ernstlichem Verlangen · § 216 Abs. 1 StGB · Der letzte Akt zählt!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Noch zwei Klausurpunkte · Verlangen: ausdrücklich und ernstlich. Bloßes Einverständnis genügt nicht. · § 216 Abs. 1 StGB · Geschäftsmäßige Förderung der Selbsttötung: § 217 StGB ist nichtig. · BVerfGE 153, 182 · § 217 ist weg!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Lösung: A ist nicht aus § 216 StGB strafbar · O beherrschte den letzten Akt selbst · Wer beherrscht · den letzten Akt? · Opfer selbst: Suizid. · Speichern fürs Examen · Hättest du § 216 bejaht? · Weiterwischen: Baustein fürs Gutachten"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "So im Gutachten · Obersatz · A könnte O auf Verlangen getötet haben. · Norm · § 216 Abs. 1 StGB · Töten setzt Herrschaft über den letzten, lebensbeendenden Akt voraus. · Subsumtion · O trank selbst und entschied frei. · Ergebnis · Suizidhilfe: A ist nicht strafbar."
        }
      ]
    },
    "b2": {
      "format": "schema",
      "fach": "assessoroer",
