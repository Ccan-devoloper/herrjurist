        "#jurastudent",
        "#examensvorbereitung"
      ],
      "quellen": [
        "§ 222 StGB",
        "§ 229 StGB",
        "§ 230 Abs. 1 StGB",
        "§ 52 StGB",
        "BGHSt 11, 1"
      ],
      "slug": "2026-12-15-b2",
      "kurztitel": "Fahrlässige Tötung und Körperverletzung",
      "regelGeprueft": true,
      "manuellGeprueft": false,
      "freigabeBetreiber": true,
      "vorproduktionStatus": "live-freigegeben",
      "textProviderKostenUsd": 0,
      "faktencheckProviderKostenUsd": 0,
      "bildStatus": "open-peeps-render",
      "renderer": "open-peeps-v4",
      "liveVorrangAktiv": true,
      "coverBadge": "Mini-Fall",
      "folien": [
        {
          "art": "titel",
          "titel": "Mini-Fall",
          "text": "Mini-Fall · Radfahrer tot – · trotzdem kein § 222 · Auch pflichtgemäß? · + Gutachten-Baustein",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der Fall · A überholt den stark betrunkenen Radfahrer R mit viel zu geringem Abstand. · R stürzt, wird überrollt und stirbt. · Gutachten: Auch mit Abstand ist ein tödlicher Sturz nicht auszuschließen. · Jetzt du: Strafbar nach § 222 StGB? · Zu knapp!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Die Prüfung · Erfolg, Kausalität · R ist tot; ohne das Überholen nicht so gestorben. · Sorgfalt verletzt · zu geringer Seitenabstand · Vorhersehbar · Sturz und Überrollen liegen nicht außerhalb der Lebenserfahrung. · Zusammenhang · Wäre der Tod auch pflichtgemäß eingetreten? · Am Ende: Baustein fürs Gutachten"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Zurechnung? · Rechtsprechung · Nur wenn feststeht, dass pflichtgemäßes Verhalten den Tod verhindert hätte. · Sonst in dubio pro reo. · Risikoerhöhung · Zurechnung, wenn A das Risiko erhöht hat. · Kritik: Verletzungs- würden Gefährdungsdelikte. · Sicher vermeidbar?"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der typische Fehler · Kausal und pflichtwidrig, also strafbar. · Übersehen: Der Erfolg muss gerade auf der Pflichtverletzung beruhen. · Pflichtwidrigkeitszusammenhang ist ein eigener Prüfungspunkt. · Genau hier!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Und § 229 StGB? · Gleiches Schema, Erfolg ist eine Körperverletzung. · Antrag oder besonderes öffentliches Interesse. · § 230 Abs. 1 StGB · Mehrere Verletzte durch eine Handlung: Tateinheit. · § 52 StGB · Antrag prüfen!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Lösung: keine Strafbarkeit nach § 222 StGB · in dubio pro reo beim Pflichtwidrigkeitszusammenhang · Auch pflichtgemäß · nicht auszuschließen: · keine Zurechnung. · Speichern fürs Examen · Wie hättest du entschieden? · Weiterwischen: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "So im Gutachten · Obersatz · § 222 StGB · A könnte fahrlässig den Tod des R verursacht haben. · Definition · Der Tod muss gerade auf der Pflichtverletzung beruhen. · Subsumtion · Mit Abstand wäre der Tod nicht sicher vermieden worden. · Ergebnis · In dubio pro reo: nicht strafbar."
        }
      ]
    },
