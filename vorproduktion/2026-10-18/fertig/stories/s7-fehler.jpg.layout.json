,"h":66},"schrift":"Space Grotesk","groesse":60,"gewicht":"400","farbe":"rgb(11, 74, 51)","ausrichtung":"start","zeilenhoehe":66,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":1104.9,"w":912,"h":601.5},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"Wurde die Beihilfe unter Verstoß gegen das Durchführungsverbot (Art. 108 Abs. 3 AEUV) gewährt, ist das Vertrauen regelmäßig nicht schutzwürdig: Ein sorgfältiger Unternehmer kann prüfen, ob das Verfahren eingehalten wurde. Nach EuGH und BVerwG weichen auch Jahresfrist (§ 48 Abs. 4 VwVfG) und Ermessen dem Effektivitätsgebot.","box":{"x":132,"y":1236.9,"w":816,"h":425.5},"schrift":"Inter","groesse":38,"gewicht":"400","farbe":"rgb(51, 1, 34)","ausrichtung":"start","zeilenhoehe":53.2,"lsp":0,"rotation":0,"pille":{"box":{"x":84,"y":1104.9,"w":912,"h":601.5},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(228, 29, 120)"},{"text":"Öffentliches Recht","box":{"x":769.1,"y":1759,"w":226.9,"h":31},"schrift":"Inter","groesse":26,"gewicht":"700","farbe":"rgb(51, 1, 34)","ausrichtung":"start","zeilenhoehe":null,"lsp":0,"rotation":0,"pille":null,"hinter":"rgb(228, 29, 120)"}],"bilder":[],"quellSha256":"dabc91a22acfc0cf5b4df8d3316d671d9737ad200de61fff748a066a575db56f"}
