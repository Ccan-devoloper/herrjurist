      "coverBadge": "Prüfungsfrage",
      "folien": [
        {
          "art": "titel",
          "titel": "Prüfungsfrage",
          "text": "Prüfungsfrage · Prügelei verabredet – · Einwilligung zählt nicht · § 228 StGB · Gruppenschlägerei · + Gutachten-Baustein · Einwilligung: ja · wirksam: nein",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Die Frage · Zwei rivalisierende Fangruppen verabreden eine Schlägerei, ohne Regeln und Sicherungen. · A schlägt B nieder: Nasenbeinbruch. · B hatte in die Auseinandersetzung eingewilligt. · Jetzt du: Ist A strafbar? · Er wollte es doch!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Lösungsweg · Tatbestand · § 223 Abs. 1 StGB · Nasenbeinbruch · Einwilligung · frei und vorher erteilt · Sittenwidrig? · § 228 StGB · Gewicht und Gefahr; bei Gruppen: Eskalation · Ergebnis · ohne Sicherungen: A strafbar · Am Ende: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der typische Fehler · „Eingewilligt ist eingewilligt.“ · „Schlägereien sind immer sittenwidrig.“ · Entscheidend: Begrenzen Absprachen und Sicherungen die Gefahr? · BGHSt 58, 140 · Gibt es Regeln?"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Wann die Einwilligung trägt · Sport nach Regeln: regelgerechte Verletzungen sind gedeckt. · Verabredeter Kampf mit wirksamen Absprachen und Sicherungen: eher wirksam. · Konkrete Todesgefahr: unbeachtlich. · Gefahr begrenzt?"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Lösung: A ist strafbar, § 223 Abs. 1 StGB · Einwilligung sittenwidrig, § 228 StGB · Ohne Absprachen · und Sicherungen: · sittenwidrig. · Speichern fürs Examen · Hättest du die Einwilligung gelten lassen? · Weiterwischen: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "So im Gutachten · Obersatz · § 228 StGB · Die Tat könnte durch Einwilligung gerechtfertigt sein. · Definition · Sittenwidrig nach Gewicht der Verletzung und Gefahr für Leib und Leben. · Subsumtion · Gruppen ohne Sicherungen: Eskalation droht. · Ergebnis · Einwilligung unbeachtlich, A strafbar."
        }
      ]
    },
    "b2": {
