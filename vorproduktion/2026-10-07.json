      "coverBadge": "Prüfungsfrage",
      "folien": [
        {
          "art": "titel",
          "titel": "Prüfungsfrage",
          "text": "Prüfungsfrage · Vollstreckungsfehler · mit § 767 ZPO? · Falsche Klage · Welcher Behelf? · + Gutachten-Baustein · § 766: wie? · § 767: ob noch?",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Zivilprozessrecht",
          "text": "Der Fall · G hat ein Urteil gegen S über 5.000 €. Nach dem Urteil zahlt S alles. · Trotzdem pfändet der Gerichtsvollzieher um 23 Uhr in der Wohnung, ohne richterliche Anordnung. · Jetzt du: Welcher Behelf wofür? · Ich hab doch bezahlt!"
        },
        {
          "art": "text",
          "titel": "Zivilprozessrecht",
          "text": "Der typische Fehler · Alles mit der Vollstreckungsabwehrklage angreifen. · Nachtpfändung ohne Anordnung: Art und Weise, also Erinnerung. · § 766 Abs. 1, § 758a Abs. 4 S. 1 ZPO · Zahlung: Einwendung gegen den Anspruch selbst. · § 767 Abs. 1 ZPO · Zwei Fehler, zwei Wege!"
        },
        {
          "art": "text",
          "titel": "Zivilprozessrecht",
          "text": "§ 767 ZPO in 4 Schritten · Statthaft · § 767 Abs. 1 ZPO · materielle Einwendung gegen den Anspruch · Zuständig · §§ 767 Abs. 1, 802 ZPO · Prozessgericht des ersten Rechtszugs · Keine Präklusion · § 767 Abs. 2 ZPO · Grund erst nach der letzten Verhandlung · Begründet · Einwendung besteht · Am Ende: Baustein fürs Gutachten"
        },
        {
          "art": "text",
          "titel": "Zivilprozessrecht",
          "text": "Erinnerung oder Klage? · § 766 ZPO · Art und Weise der Vollstreckung · entscheidet das Vollstreckungsgericht · § 764 ZPO · § 767 ZPO · Anspruch selbst: Erfüllung, Erlass, Aufrechnung · Klage beim Prozessgericht · Recht eines Dritten? § 771!"
        },
        {
          "art": "text",
          "titel": "Zivilprozessrecht",
          "text": "Lösung: zwei Behelfe · Zahlung: § 767 ZPO · Nachtpfändung: § 766 ZPO · Wie vollstreckt? § 766, · Ob noch? § 767, · Wessen Sache? § 771. · Speichern fürs Examen · Hättest du beide gesehen? · Weiterwischen: Baustein fürs Gutachten"
        },
        {
          "art": "text",
          "titel": "Zivilprozessrecht",
          "text": "So im Gutachten · Obersatz · Die Klage des S hat Erfolg, wenn sie zulässig und begründet ist. · Norm · § 767 Abs. 1, 2 ZPO · Einwendung gegen den Anspruch, später entstanden · Subsumtion · § 362 Abs. 1 BGB · S zahlte nach dem Urteil: Erfüllung, nicht präkludiert · Ergebnis · Vollstreckung für unzulässig erklären"
        }
      ]
