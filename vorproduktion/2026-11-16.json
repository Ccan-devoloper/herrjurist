      "folien": [
        {
          "art": "titel",
          "titel": "Klausurschema",
          "text": "Klausurschema · Schutzpflicht verletzt? · Kein Übermaß prüfen · Art. 2 Abs. 2 S. 1 GG · 4 Schritte · + Gutachten-Baustein · Übermaß · Eingriff · Untermaß · Schutzpflicht",
          "bild": "op-cover"
