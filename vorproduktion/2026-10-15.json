      "folien": [
        {
          "art": "titel",
          "titel": "Vergleich",
          "text": "Vergleich · Persönlichkeit · verletzt? Erst · abwägen · § 823 Abs. 1 BGB · Rahmenrecht · + Gutachten-Baustein · Rechtsgut · oder · Rahmenrecht",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Deliktsrecht",
          "text": "Der Fall · Zeitschrift Z berichtet ausführlich über die Scheidung der Moderatorin M. · M verlangt Unterlassung. · Jetzt du: Ist der Eingriff schon rechtswidrig? · Mein Privatleben!"
        },
        {
          "art": "text",
          "titel": "Deliktsrecht",
          "text": "Woher kommt das Recht? · Nicht im BGB geregelt, von der Rechtsprechung entwickelt. · Art. 2 Abs. 1 i. V. m. Art. 1 Abs. 1 GG · Geschützt als sonstiges Recht. · § 823 Abs. 1 BGB · Richterrecht!"
        },
        {
          "art": "text",
          "titel": "Deliktsrecht",
          "text": "Rechtsgut oder Rahmenrecht? · Rechtsgut · Eingriff indiziert die Rechtswidrigkeit · nur noch Rechtfertigung prüfen · Rahmenrecht · Rechtswidrigkeit positiv feststellen · abwägen, etwa mit der Pressefreiheit · Art. 5 Abs. 1 S. 2 GG · Erst abwägen!"
        },
        {
          "art": "text",
          "titel": "Deliktsrecht",
          "text": "Sphären in der Abwägung · Intimsphäre: grundsätzlich absolut geschützt. · Privatsphäre: Abwägung mit dem Informationsinteresse. · Sozialsphäre: wahre Berichte eher hinzunehmen. · Bildnisse: vorrangig das KUG · §§ 22, 23 KUG · Scheidung: privat?"
        },
        {
          "art": "text",
          "titel": "Deliktsrecht",
          "text": "Welche Rechtsfolge? · Abwehr · Unterlassung, Beseitigung · § 1004 BGB analog · Widerruf unwahrer Tatsachen · Geldentschädigung · nur bei schwerer Verletzung ohne andere Abhilfe · aus dem Schutzauftrag des GG, nicht § 253 BGB · Geld nur selten!"
        },
        {
          "art": "text",
          "titel": "Deliktsrecht",
          "text": "Lösung: erst die Abwägung entscheidet · Rahmenrecht: Rechtswidrigkeit nicht indiziert · Rahmenrecht: · Abwägung entscheidet · über die Rechtswidrigkeit. · Speichern fürs Examen · Hättest du die Abwägung vergessen? · Weiterwischen: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Deliktsrecht",
          "text": "So im Gutachten · Obersatz · §§ 823 Abs. 1, 1004 BGB analog · M könnte Unterlassung verlangen. · Definition · Rahmenrecht: Rechtswidrigkeit durch Abwägung · Subsumtion · Scheidung betrifft die Privatsphäre, gegen das Informationsinteresse abwägen. · Ergebnis · Rechtswidrig, wenn Ms Schutzinteresse überwiegt."
        }
      ]
