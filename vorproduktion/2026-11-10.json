      "folien": [
        {
          "art": "titel",
          "titel": "Streitstand",
          "text": "Streitstand · Spontan zugestochen – · trotzdem Mord? · § 211 Abs. 2 StGB · Verdeckung · + Gutachten-Baustein",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der Fall · A schlägt B im Streit nieder. B ruft: „Das zeige ich an!“ · A beschließt sofort, B zu töten, damit die Körperverletzung nicht herauskommt. B stirbt. · Jetzt du: Verdeckungsmord trotz Spontaneität? · Ohne Plan?"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Spontane Verdeckungstat · Rechtsprechung · Verdeckungsabsicht auch bei spontanem Entschluss · Unmittelbarer Anschluss an die Vortat schadet nicht · Teile der Lehre · Einschränkung wegen lebenslanger Strafe · § 211 Abs. 1 StGB · Spontantat aus Konflikt: nur Totschlag · § 212 StGB · Wer hat recht?"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Stellungnahme · Der Wortlaut verlangt keinen Plan. · § 211 Abs. 2 StGB · A stellt sein Interesse, unentdeckt zu bleiben, über das Leben von B. · Klausur: der Rechtsprechung folgen, Gegenansicht nennen. · Kein Plan nötig!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der typische Fehler · „Spontan, also kein Mord“ – ohne Streitdarstellung. · Die Vortat muss eine andere Tat sein: hier die Körperverletzung. · § 223 Abs. 1 StGB · Verdeckungsabsicht im subjektiven Tatbestand prüfen. · Erst die Vortat!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Lösung: Mord (Rechtsprechung) · Verdeckungsabsicht, § 211 Abs. 2 StGB; Lehre teils: § 212 StGB · Spontan schließt · Verdeckung nicht aus – · andere Tat nötig. · Speichern fürs Examen · Wie hättest du entschieden? · Weiterwischen: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "So im Gutachten · Obersatz · §§ 212 Abs. 1, 211 Abs. 2 StGB · A könnte sich wegen Mordes strafbar gemacht haben. · Definition · töten, um die Aufdeckung einer anderen Tat zu verhindern · Subsumtion · Körperverletzung als Vortat; Anzeige verhindern; spontan unschädlich · Ergebnis · Mord nach der Rechtsprechung"
        }
      ]
