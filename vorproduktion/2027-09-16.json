      "folien": [
        {
          "art": "titel",
          "titel": "Unmittelbare Ausführung: drei Merkmale, eine gedachte Verfügung",
          "titelZeilen": [
            "Unmittelbare",
            "Ausführung: drei",
            "Merkmale, eine",
            "gedachte Verfügung"
          ],
          "coverBadge": "Spickzettel",
          "coverText": "Erst die gedachte Grundverfügung",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Worum es geht",
          "text": "Die Polizei handelt selbst oder durch einen Beauftragten, weil sie den Verantwortlichen nicht rechtzeitig heranziehen kann – etwa den verreisten Eigentümer eines Hauses, dessen loses Dach auf den Gehweg zu stürzen droht. Geregelt je nach Landesrecht; nicht jedes Land kennt das Institut."
        },
        {
          "art": "text",
          "titel": "Die drei Merkmale",
          "punkte": [
            "1. Eine Verfügung gegen den Verantwortlichen wäre rechtmäßig (hypothetische Grundverfügung).",
            "2. Der Zweck ist durch seine Inanspruchnahme nicht oder nicht rechtzeitig erreichbar.",
            "3. Die Polizei führt die Maßnahme selbst oder durch einen Beauftragten aus."
          ]
        },
        {
          "art": "vergleich",
          "titel": "Abgrenzung zum Sofortvollzug",
          "links": {
            "titel": "Unmittelbare Ausführung",
            "punkte": [
              "Maßnahme der Gefahrenabwehr",
              "Verantwortlicher nicht erreichbar",
              "Kein entgegenstehender Wille"
            ]
          },
          "rechts": {
            "titel": "Sofortvollzug",
            "punkte": [
              "Vollstreckung ohne vorherigen VA",
              "Richtet sich gegen einen Willen",
              "Regeln des Vollstreckungsrechts"
            ]
          }
        },
        {
          "art": "text",
          "titel": "Kosten und Rechtsschutz",
          "text": "Die Kosten fordert die Behörde je nach Landesrecht per Bescheid vom Verantwortlichen. Die Maßnahme selbst ist meist erledigt. Gegen den Kostenbescheid gehst du mit der Anfechtungsklage vor – und prüfst dort inzident, ob die unmittelbare Ausführung rechtmäßig war."
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Prüf zuerst die gedachte Verfügung gegen den Verantwortlichen. Nur wenn sie rechtmäßig wäre, trägt die unmittelbare Ausführung."
        },
        {
          "art": "cta",
          "titel": "Unmittelbare Ausführung prüfen",
          "punkte": [
            "Gedachte Grundverfügung rechtmäßig?",
            "Verantwortlicher nicht rechtzeitig erreichbar?",
            "Kostenbescheid: inzident prüfen"
          ],
          "icons": [
            "polizei",
            "uhr",
            "quittung"
          ]
        }
      ],
      "caption": "Unmittelbare Ausführung: drei Merkmale und eine gedachte Verfügung. Die Polizei handelt selbst, weil sie den Verantwortlichen nicht rechtzeitig heranziehen kann. Rechtmäßig ist das nur, wenn eine Verfügung gegen ihn rechtmäßig wäre. Vom Sofortvollzug grenzt du nach dem Willen des Betroffenen ab – je nach Landesrecht. Speichern für die nächste Polizeirechtsklausur.",
