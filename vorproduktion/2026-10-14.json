      "coverBadge": "Prüfungsfrage",
      "folien": [
        {
          "art": "titel",
          "titel": "Prüfungsfrage",
          "text": "Prüfungsfrage · Detektiv gestoßen – · trotzdem kein · § 252 StGB · Wer nur flieht · + Gutachten-Baustein",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der Fall · D steckt im Supermarkt eine Flasche Whisky in die Jacke und geht an der Kasse vorbei. · Draußen stößt er den Detektiv um, lässt die Flasche fallen und rennt weg. · Jetzt du: räuberischer Diebstahl? · Nur weg hier!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "§ 252 StGB in 4 Schritten · Vortat · Diebstahl vollendet, aber nicht beendet · Auf frischer Tat betroffen · enger räumlich-zeitlicher Zusammenhang · Gewalt oder Drohung · gegen eine Person, Gefahr für Leib oder Leben · Besitzerhaltungsabsicht · Er will die Beute behalten. · Am Ende: Baustein für das Gutachten"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Der typische Fehler · Jede Gewalt nach dem Diebstahl als § 252 StGB werten. · Wer nur fliehen will und die Beute aufgibt, will sie nicht behalten. · Behalten muss nicht das einzige Motiv sein. · Flasche liegt da!"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Behalten oder nur fliehen? · Will behalten · gleich einem Räuber bestraft · § 252 StGB · Flasche bleibt in der Jacke · Will nur fliehen · Diebstahl, kein § 252 · § 242 StGB · daneben etwa §§ 223, 240 StGB · Was will D?"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "Lösung: kein räuberischer Diebstahl · Diebstahl, daneben etwa §§ 223, 240 StGB · Vollendet, nicht beendet, · frische Tat, Gewalt, · Beute behalten wollen. · Speichern fürs Examen · Hättest du § 252 bejaht? · Weiterwischen: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Strafrecht BT",
          "text": "So im Gutachten · Obersatz · § 252 StGB · D könnte räuberischen Diebstahl begangen haben. · Definition · Absicht, sich die Beute zu erhalten. · Subsumtion · D lässt die Flasche fallen und will nur entkommen. · Ergebnis · Keine Besitzerhaltungsabsicht, kein § 252 StGB."
        }
      ]
    },
    "b2": {
      "format": "pruefungsfrage",
