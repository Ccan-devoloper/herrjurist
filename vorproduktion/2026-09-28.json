      "folien": [
        {
          "art": "titel",
          "titel": "Gestohlen und gutgläubig gekauft – wird der Käufer Eigentümer?",
          "unter": "§§ 932, 935 BGB: Guter Glaube ersetzt nicht jeden Besitzverlust",
          "icon": "schloss",
          "titelZeilen": [
            "Gestohlen +",
            "gutgläubig gekauft –",
            "Eigentum erworben?"
          ],
          "coverBadge": "Prüfungsfrage",
          "coverText": "§ 935 blockiert den Erwerb",
          "coverBildAuslassen": true,
          "pille": "Swipen →",
          "hinweis": "Sachenrecht"
        },
        {
          "art": "text",
          "titel": "Ausgangspunkt: § 932 BGB",
          "text": "Bei einer Übereignung nach § 929 BGB kann der Erwerber trotz fehlender Eigentümerstellung des Veräußerers Eigentum erwerben, wenn die gesetzlichen Gutglaubensvoraussetzungen vorliegen.",
          "icon": "hand"
        },
        {
          "art": "text",
          "titel": "Die Sperre: § 935 Abs. 1 BGB",
          "text": "Ist die Sache dem Eigentümer gestohlen worden, verloren gegangen oder sonst abhandengekommen, scheidet der gutgläubige Erwerb grundsätzlich aus. Entscheidend ist der unfreiwillige Verlust des unmittelbaren Besitzes.",
          "icon": "sperre"
        },
        {
          "art": "vergleich",
          "titel": "Freiwillig oder unfreiwillig?",
          "links": {
            "titel": "Besitz freiwillig übertragen",
            "punkte": [
              "§ 935 greift grundsätzlich nicht",
              "Gutgläubiger Erwerb kann möglich sein",
              "Beispiel: Leihe an einen Nichtberechtigten"
            ]
          },
          "rechts": {
            "titel": "Besitz unfreiwillig verloren",
            "punkte": [
              "Abhandenkommen",
              "§ 935 Abs. 1 sperrt grundsätzlich",
              "Beispiel: Diebstahl oder Verlieren"
            ]
          }
        },
        {
          "art": "text",
          "titel": "Ausnahme in § 935 Abs. 2 BGB",
          "text": "Die Abhandenkommenssperre gilt nicht für Geld, Inhaberpapiere und Sachen, die im Wege öffentlicher Versteigerung veräußert werden. Diese Ausnahme ausdrücklich mitprüfen.",
          "icon": "ausnahme"
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Beim gutgläubigen Erwerb immer fragen: War der Besitzverlust freiwillig? Guter Glaube heilt kein Abhandenkommen."
        },
        {
          "art": "cta",
          "titel": "Drei Prüfstationen",
          "punkte": [
            "§ 929 BGB: Verfügungstatbestand",
            "§ 932 BGB: guter Glaube",
            "§ 935 BGB: Abhandenkommen/Ausnahme"
          ],
          "icon": "lesezeichen"
        }
      ],
      "caption": "Gestohlen und gutgläubig weiterverkauft? Der gute Glaube allein genügt nicht. § 935 Abs. 1 BGB sperrt den gutgläubigen Erwerb grundsätzlich, wenn die Sache dem Eigentümer gestohlen wurde, verloren ging oder sonst abhandenkam. Der Schlüssel ist der unfreiwillige Besitzverlust. § 935 Abs. 2 BGB enthält die wichtigen Ausnahmen.",
