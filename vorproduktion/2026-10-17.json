  "inhalte": {
    "b1": {
      "format": "klausurtechnik",
      "fach": "methodik",
      "klausur": 0,
      "fachLabel": "Klausur- und Lernmethodik",
      "themaId": "methodik-898",
      "caption": "„Fraglich ist, ob …“ ist kein Obersatz.\n\n▸ Ein subsumtionsfähiger Obersatz nennt, wer was von wem woraus verlangt – im Strafrecht, wer sich durch welches Verhalten nach welcher Norm strafbar gemacht haben könnte.\n▸ Zu vage: „A könnte sich strafbar gemacht haben.“ Präzise: „A könnte sich wegen Diebstahls nach § 242 Abs. 1 StGB strafbar gemacht haben, indem er die Uhr wegnahm.“ Oder: „K könnte gegen V einen Anspruch auf Übereignung aus § 433 Abs. 1 S. 1 BGB haben.“\n▸ Die Norm so genau wie möglich zitieren: mit Absatz, Satz, Alternative.\n▸ Jedes problematische Merkmal bekommt einen eigenen kleinen Obersatz, dann Definition, Subsumtion, Ergebnis. „Fraglich ist …“ darf danach das Problem einleiten – den Obersatz ersetzt es nicht.\n\nZum Schluss: der Baustein für dein Gutachten. Speichern fürs Examen 📌",
      "hashtags": [
        "#jura",
        "#jurastudium",
        "#staatsexamen",
        "#erstesstaatsexamen",
        "#klausurtechnik",
        "#gutachtenstil",
        "#klausurtraining",
        "#jurastudent",
        "#examensvorbereitung"
      ],
      "quellen": [
        "§ 242 Abs. 1 StGB (Beispiel)",
        "§ 433 Abs. 1 S. 1 BGB (Beispiel)"
      ],
      "slug": "2026-10-17-b1",
      "kurztitel": "Obersatztechnik: präzise und subsumtionsfähig formulieren",
      "regelGeprueft": true,
      "manuellGeprueft": false,
      "freigabeBetreiber": true,
      "vorproduktionStatus": "live-freigegeben",
      "textProviderKostenUsd": 0,
      "faktencheckProviderKostenUsd": 0,
      "bildStatus": "open-peeps-render",
      "renderer": "open-peeps-v4",
      "liveVorrangAktiv": true,
      "coverBadge": "Klausurtechnik",
      "folien": [
        {
          "art": "titel",
          "titel": "Klausurtechnik",
          "text": "Klausurtechnik · „Fraglich ist …“ · ist kein Obersatz · 4 Bausteine · + Gutachten-Baustein · Wer? · Was? · Woraus? · Wodurch?",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Klausur- und Lernmethodik",
          "text": "Das Problem · „Fraglich ist, ob A strafbar ist.“ · Keine Norm, kein Tatbestand: Der Korrektor weiß nicht, was du prüfst. · Ein Obersatz muss sich Punkt für Punkt abarbeiten lassen. · Jetzt du: Wie wird er präzise? · Was prüfe ich?"
        },
        {
          "art": "text",
          "titel": "Klausur- und Lernmethodik",
          "text": "Zu vage oder präzise? · Zu vage · „A könnte sich strafbar gemacht haben.“ · „Fraglich ist, ob ein Vertrag besteht.“ · Präzise · „A könnte durch Wegnahme der Uhr einen Diebstahl begangen haben.“ · § 242 Abs. 1 StGB · „K könnte von V Übereignung verlangen.“ · § 433 Abs. 1 S. 1 BGB · Norm rein!"
        },
        {
          "art": "text",
          "titel": "Klausur- und Lernmethodik",
          "text": "Die vier Bausteine · Wer? · Anspruchsteller und Gegner oder der Täter · Was? · das konkrete Begehren oder Delikt · Woraus? · die Norm mit Absatz, Satz, Alternative · Wodurch? · im Strafrecht das Verhalten: „indem er …“ · Am Ende: Baustein für das Gutachten"
        },
        {
          "art": "text",
          "titel": "Klausur- und Lernmethodik",
          "text": "Der typische Fehler · „Fraglich ist …“ ersetzt den Obersatz. · Jedes problematische Merkmal bekommt einen eigenen kleinen Obersatz. · Dann Definition, Subsumtion, Ergebnis. · Erst der Obersatz!"
        },
        {
          "art": "text",
          "titel": "Klausur- und Lernmethodik",
          "text": "Lösung: wer, was, von wem, woraus · im Strafrecht: wer, wodurch, nach welcher Norm · Wer will was · von wem woraus? · Erst dann subsumieren. · Speichern fürs Examen · Wie startet dein Obersatz? · Weiterwischen: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Klausur- und Lernmethodik",
          "text": "So im Gutachten · Obersatz · § 242 Abs. 1 StGB · Die Uhr müsste für A eine fremde Sache sein. · Definition · Fremd: nicht Alleineigentum des Täters, nicht herrenlos · Subsumtion · Die Uhr gehört O. · Ergebnis · Die Uhr ist für A fremd."
        }
      ]
    },
    "b2": {
      "format": "spickzettel",
      "fach": "verwbt",
      "klausur": 3,
      "fachLabel": "Besonderes Verwaltungsrecht",
      "themaId": "verwbt-113",
      "caption": "Drei Wege führen zur Polizeipflicht: Verhalten, Zustand und – nur im polizeilichen Notstand – die Inanspruchnahme des Nichtstörers. Landesrecht prüfen: Die Details regeln die Polizei- und Ordnungsgesetze der Länder, deshalb gehört die Landesnorm an den Anfang. Zum Vergleich das Bundesrecht: §§ 17, 18, 20 BPolG.\n\n▸ Verhaltensverantwortlich ist, wer die Gefahr verursacht – nach der Unmittelbarkeitslehre, wer selbst die Gefahrenschwelle überschreitet. Der Zweckveranlasser ist überwiegend anerkannt, im Einzelnen umstritten.\n▸ Zustandsverantwortlich ist der Inhaber der tatsächlichen Gewalt, daneben der Eigentümer – nicht, wenn der Inhaber die Gewalt ohne seinen Willen ausübt (vgl. § 18 Abs. 2 BPolG).\n▸ Nichtstörer nur bei gegenwärtiger erheblicher Gefahr, wenn Verantwortliche nicht oder nicht rechtzeitig herangezogen werden können (vgl. § 20 Abs. 1 BPolG).\n▸ Mehrere Verantwortliche: Auswahl nach pflichtgemäßem Ermessen, Leitlinie ist die effektive Gefahrenabwehr – keine starre Rangfolge.\n▸ Im Fall: M ist Verhaltens- und als Mieter Zustandsstörer, E als Eigentümerin Zustandsstörerin.\n\nZum Schluss: der Baustein für dein Gutachten. Speichern fürs Examen 📌",
      "hashtags": [
        "#jura",
        "#jurastudium",
        "#staatsexamen",
        "#öffentlichesrecht",
        "#polizeirecht",
        "#störer",
        "#gefahrenabwehr",
        "#jurastudent",
        "#examensvorbereitung"
      ],
      "quellen": [
        "Polizei- und Ordnungsgesetze der Länder",
        "§§ 17, 18, 20 BPolG"
      ],
      "slug": "2026-10-17-b2",
      "kurztitel": "Wer ist Störer im Polizei- und Ordnungsrecht?",
      "regelGeprueft": true,
      "manuellGeprueft": false,
      "freigabeBetreiber": true,
      "vorproduktionStatus": "live-freigegeben",
      "textProviderKostenUsd": 0,
      "faktencheckProviderKostenUsd": 0,
      "bildStatus": "open-peeps-render",
      "renderer": "open-peeps-v4",
      "liveVorrangAktiv": true,
      "coverBadge": "Spickzettel",
      "folien": [
        {
          "art": "titel",
          "titel": "Spickzettel",
          "text": "Spickzettel · E lagert nichts – · trotzdem · Störerin · Polizeirecht · Landesrecht prüfen · Störer finden · + Gutachten-Baustein",
          "bild": "op-cover"
        },
        {
          "art": "text",
          "titel": "Besonderes Verwaltungsrecht",
          "text": "Der Fall · Mieter M lagert undichte Ölfässer auf dem Grundstück der Eigentümerin E. · Öl ist ins Erdreich gesickert und droht ins Grundwasser zu gelangen. · Jetzt du: Wer ist verantwortlich? · Ich doch nicht!"
        },
        {
          "art": "text",
          "titel": "Besonderes Verwaltungsrecht",
          "text": "Drei Wege zur Verantwortlichkeit · Verhalten · z. B. § 17 BPolG · wer die Gefahr verursacht · Zustand · z. B. § 18 BPolG · Inhaber der tatsächlichen Gewalt, auch der Eigentümer · Nichtstörer · z. B. § 20 BPolG · nur im polizeilichen Notstand · Am Ende: Baustein für das Gutachten"
        },
        {
          "art": "text",
          "titel": "Besonderes Verwaltungsrecht",
          "text": "Wann ist Verhalten ursächlich? · Unmittelbarkeit · überschreitet selbst die Gefahrenschwelle · mittelbare Beiträge genügen nicht · Zweckveranlasser · bezweckt das Störerverhalten Dritter · anerkannt, im Einzelnen umstritten · Wer überschreitet?"
        },
        {
          "art": "text",
          "titel": "Besonderes Verwaltungsrecht",
          "text": "Der typische Fehler · Starre Rangfolge: erst Verhalten, dann Zustand. · Auswahl nach Ermessen, Leitlinie: effektive Gefahrenabwehr. · Landesrecht prüfen: Die Polizeigesetze der Länder regeln die Details. · Ermessen!"
        },
        {
          "art": "text",
          "titel": "Besonderes Verwaltungsrecht",
          "text": "Lösung · M verursacht die Gefahr und hat die tatsächliche Gewalt. · E ist als Eigentümerin Zustandsstörerin. · Auswahl zwischen M und E nach Ermessen · Also auch ich."
        },
        {
          "art": "text",
          "titel": "Besonderes Verwaltungsrecht",
          "text": "Lösung: M und E sind verantwortlich · Auswahl nach pflichtgemäßem Ermessen · Verhalten oder Zustand, · Nichtstörer nur · im Notstand. · Speichern fürs Examen · Hättest du E übersehen? · Weiterwischen: Gutachten-Baustein"
        },
        {
          "art": "text",
          "titel": "Besonderes Verwaltungsrecht",
          "text": "So im Gutachten · Obersatz · Landesrecht prüfen · E müsste als Zustandsstörerin verantwortlich sein. · Definition · Inhaber der Gewalt oder Eigentümer der gefährlichen Sache · Subsumtion · Vom verseuchten Grundstück der E geht die Gefahr aus. · Ergebnis · E ist Zustandsstörerin."
        }
      ]
    },
    "b3": {
