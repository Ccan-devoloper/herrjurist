      "folien": [
        {
          "art": "titel",
          "titel": "Mini-Fall",
          "text": "Mini-Fall · „Nur ein Denkzettel“? · Trotzdem Totschlag · § 212 Abs. 1 StGB · Tötungsvorsatz · + Gutachten-Baustein · Motiv · Denkzettel · Vorsatz · in Kauf genommen",
          "bild": "op-cover"
