{"version":1,"breite":1080,"hoehe":1350,"texte":[{"text":"Strafrecht BT","box":{"x":0,"y":0,"w":268.8,"h":62.8},"innen":{"x":40,"y":16,"w":182.8,"h":30.8},"schrift":"Inter","groesse":28,"gewicht":"700","farbe":"rgb(255, 255, 255)","ausrichtung":"start","zeilenhoehe":30.8,"lsp":0.6,"rotation":0,"pille":{"box":{"x":0,"y":0,"w":268.8,"h":62.8},"farbe":"rgb(53, 26, 10)","radius":0},"hinter":"rgb(251, 144, 47)"},{"text":"4/7","box":{"x":974,"y":30,"w":68,"h":68},"schrift":"Inter","groesse":25,"gewicht":"700","farbe":"rgb(255, 255, 255)","ausrichtung":"start","zeilenhoehe":null,"lsp":1.6,"rotation":0,"pille":{"box":{"x":974,"y":30,"w":68,"h":68},"farbe":"rgb(53, 26, 10)","radius":50},"hinter":"rgb(251, 144, 47)"},{"text":"So prüfst du die Verdeckungsabsicht","box":{"x":76,"y":321.3,"w":928,"h":156.8},"innen":{"x":110,"y":335.3,"w":860,"h":128.8},"schrift":"Space Grotesk","groesse":56,"gewicht":"700","farbe":"rgb(255, 255, 255)","ausrichtung":"start","zeilenhoehe":64.4,"lsp":-0.6,"rotation":0,"pille":{"box":{"x":76,"y":321.3,"w":928,"h":156.8},"farbe":"rgb(53, 26, 10)","radius":44},"hinter":"rgb(251, 144, 47)"},{"text":"Andere Straftat","box":{"x":204,"y":536,"w":770,"h":43.2},"schrift":"Inter","groesse":36,"gewicht":"700","farbe":"rgb(53, 26, 10)","ausrichtung":"start","zeilenhoehe":43.2,"lsp":0,"rotation":0,"pille":{"box":{"x":76,"y":512,"w":928,"h":175.5},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(251, 144, 47)"},{"text":"Die Vortat ist eine Straftat, auch eine eigene. Eine bloße Ordnungswidrigkeit genügt nicht.","box":{"x":204,"y":585.2,"w":770,"h":78.3},"schrift":"Inter","groesse":29,"gewicht":"400","farbe":"rgb(43, 43, 51)","ausrichtung":"start","zeilenhoehe":39.2,"lsp":0,"rotation":0,"pille":{"box":{"x":76,"y":512,"w":928,"h":175.5},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(251, 144, 47)"},{"text":"Ziel: verdecken","box":{"x":204,"y":731.5,"w":770,"h":43.2},"schrift":"Inter","groesse":36,"gewicht":"700","farbe":"rgb(53, 26, 10)","ausrichtung":"start","zeilenhoehe":43.2,"lsp":0,"rotation":0,"pille":{"box":{"x":76,"y":707.5,"w":928,"h":214.6},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(251, 144, 47)"},{"text":"Der Täter will die Aufdeckung der Vortat oder seiner Täterschaft verhindern – nicht, wenn er meint, die Behörden wüssten schon alles.","box":{"x":204,"y":780.7,"w":770,"h":117.4},"schrift":"Inter","groesse":29,"gewicht":"400","farbe":"rgb(43, 43, 51)","ausrichtung":"start","zeilenhoehe":39.2,"lsp":0,"rotation":0,"pille":{"box":{"x":76,"y":707.5,"w":928,"h":214.6},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(251, 144, 47)"},{"text":"Absicht","box":{"x":204,"y":966.1,"w":770,"h":43.2},"schrift":"Inter","groesse":36,"gewicht":"700","farbe":"rgb(53, 26, 10)","ausrichtung":"start","zeilenhoehe":43.2,"lsp":0,"rotation":0,"pille":{"box":{"x":76,"y":942.1,"w":928,"h":214.6},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(251, 144, 47)"},{"text":"Der Verdeckungserfolg muss sein Ziel sein. Zum Tod des Opfers kann nach der Rspr. auch bedingter Vorsatz genügen.","box":{"x":204,"y":1015.3,"w":770,"h":117.4},"schrift":"Inter","groesse":29,"gewicht":"400","farbe":"rgb(43, 43, 51)","ausrichtung":"start","zeilenhoehe":39.2,"lsp":0,"rotation":0,"pille":{"box":{"x":76,"y":942.1,"w":928,"h":214.6},"farbe":"rgba(255, 255, 255, 0.92)","radius":30},"hinter":"rgb(251, 144, 47)"},{"text":"Strafrecht","box":{"x":878.8,"y":1255,"w":125.2,"h":31},"schrift":"Inter","groesse":26,"gewicht":"700","farbe":"rgb(53, 26, 10)","ausrichtung":"start","zeilenhoehe":null,"lsp":0,"rotation":0,"pille":null,"hinter":"rgb(251, 144, 47)"}],"bilder":[],"quellSha256":"f248fa0b074bcd2e0a549f5e7d44076e6ea33a4d56d5d936f87a0f2f670c9bee"}
